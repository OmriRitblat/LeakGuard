# PostgreSQL configuration
POSTGRES_DB=leakguard
POSTGRES_USER=leakguard
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
# Base64-encoded 32-byte AES-256 encryption key
LEAKGUARD_ENCRYPTION_KEY=
# LiteLLM Proxy master key (clients send it as "Authorization: Bearer <key>").
# Generate it with: python scripts/generate_litellm_master_key.py
LITELLM_MASTER_KEY=